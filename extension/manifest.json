{
  "manifest_version": 3,
  "name": "PassForge",
  "version": "0.8.0",
  "description": "Fill usernames and passwords on login forms from your local PassForge vault.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": ["nativeMessaging"]
}
